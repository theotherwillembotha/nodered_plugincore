{
  "name": "@theotherwillembotha/nodered_plugincore",
  "version": "0.0.41",
  "description": "A TypeScript framework for building production-grade Node-RED plugins, with built-in logging, Prometheus metrics, and webhook support.",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red", "logging", "metrics", "webhook", "reverseproxy"
  ],
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build",
    "clean": "rm -rf ./build",
    "build": "npm run clean && tsc && npm run copy-html && npm run generate-nodes && npm run copy-files",
    "generate-nodes": "node build/GenerateNodes.js",
    "copy-html": "cd src && find -type f -name '*Template.html' -exec cp --parents '{}' ../build/ ';' && find -type f -name '*Node.html' -exec cp --parents '{}' ../build/ ';' && cd ..",
    "copy-files": "cp -r ./icons ./build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theotherwillembotha/nodered_plugincore.git"
  },
  "bugs": {
    "url": "https://github.com/theotherwillembotha/nodered_plugincore/issues"
  },
  "types": "./build/index.d.ts",
  "files": ["build/", "src/", "icons/", "LICENSE", "README.md"],
  "homepage": "https://github.com/theotherwillembotha/nodered_plugincore#readme",
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.29",
    "@types/node-red": "~1.3.5",
    "@types/whatwg-url": "^13.0.0"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "deep-equal": "^2.2.3",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "js-beautify": "^1.15.4",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.1.0",
    "network": "^0.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "whatwg-url": "^14.2.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3"
  },
  "node-red": {
    "nodes": {
      "core": "./build/Nodes.js"
    },
    "plugins": {
      "core": "./build/Plugins.js"
    }
  }
}
