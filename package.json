{
  "name": "@theotherwillembotha/node-red-plugincore",
  "version": "0.2.0",
  "description": "A core framework for building production-grade Node-RED plugins, with built-in support for structured logging, metrics, and webhook ingestion.",
  "author": "Willem Botha (@theotherwillembotha)",
  "license": "ISC",
  "keywords": [
    "node-red",
    "logging",
    "metrics",
    "webhook",
    "reverseproxy"
  ],
  "main": "./build/index.js",
  "exports": "./build/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "npm run build",
    "clean": "rm -rf ./build && rm -rf ./resources",
    "build": "npm run clean && tsc && npm run generate-nodes && npm run copy-files",
    "generate-nodes": "node build/GenerateNodes.js",
    "copy-files": "cp -r ./icons ./build && mkdir -p ./resources && cp -r ./build/resources/. ./resources/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theotherwillembotha/nodered_plugincore.git"
  },
  "bugs": {
    "url": "https://github.com/theotherwillembotha/nodered_plugincore/issues"
  },
  "types": "./build/index.d.ts",
  "files": [
    "build/",
    "src/",
    "icons/",
    "resources/",
    "documentation/",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/theotherwillembotha/nodered_plugincore#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "nodered": ">=4.0.0"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/node-red": "~1.3.5",
    "@types/whatwg-url": "^13.0.0"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "deep-equal": "^2.2.3",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "js-beautify": "^1.15.4",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.1.0",
    "network": "^0.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "whatwg-url": "^16.0.1",
    "winston": "^3.17.0"
  },
  "node-red": {
    "version": ">=4.0.0",
    "nodes": {
      "core": "./build/Nodes.js"
    },
    "plugins": {
      "core": "./build/Plugins.js"
    }
  }
}
